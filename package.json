{
  "name": "pi-agent-extensions-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for independently published pi extensions and skills",
  "type": "module",
  "scripts": {
    "test": "vp run -r test",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint:staged": "vp staged",
    "pack:check": "vp pm pack -r --filter './extensions/*' -- --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "pi": {
    "extensions": [
      "./extensions/ask/index.ts",
      "./extensions/plan-mode/index.ts",
      "./extensions/prompt-history-search/index.ts",
      "./extensions/prompt-truly-mine/index.ts",
      "./extensions/provider-url-logger/index.ts",
      "./extensions/status-bar/index.ts",
      "./extensions/tool-output-browser/index.ts"
    ],
    "skills": [
      "./extensions/jenkins-cli-operations/SKILL.md"
    ]
  }
}
