{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["extensions/**/*.ts"],
      "options": {
        "useTabs": true,
        "tabWidth": 4
      }
    },
    {
      "files": ["extensions/jenkins-cli-operations/**/*.mjs"],
      "options": {
        "useTabs": false,
        "tabWidth": 4,
        "singleQuote": true
      }
    }
  ]
}
