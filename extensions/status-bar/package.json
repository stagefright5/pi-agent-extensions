{
  "name": "@stagefright5/pi-status-bar",
  "version": "0.3.0",
  "description": "A compact single-line status bar for pi",
  "type": "module",
  "keywords": [
    "status-bar",
    "tui"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/status-bar",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Compact Status Bar",
    "interface": "Automatic in TUI mode"
  }
}
