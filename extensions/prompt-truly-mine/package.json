{
  "name": "@stagefright5/pi-prompt-truly-mine",
  "version": "0.4.0",
  "description": "Inline extension commands and composable skill/prompt context with cursor-restoring undo and redo for pi",
  "type": "module",
  "keywords": [
    "prompt-editor"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@stagefright5/pi-picker": "workspace:*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/prompt-truly-mine",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Prompt Truly Mine",
    "interface": "`$` references, inline `/`, `Ctrl+Z`, redo shortcuts"
  }
}
