{
  "name": "@stagefright5/pi-provider-url-logger",
  "version": "0.1.3",
  "description": "Log the provider, model, and base URL selected for pi provider requests",
  "type": "module",
  "keywords": [
    "provider",
    "logging"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@types/proper-lockfile": "^4.1.4"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/provider-url-logger",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Provider URL Logger",
    "interface": "Automatic"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
