{
  "name": "@stagefright5/pi-prompt-history-search",
  "version": "0.2.0",
  "description": "Fuzzy reverse search across prompts in saved pi sessions",
  "type": "module",
  "keywords": [
    "prompt-history"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@stagefright5/pi-picker": "workspace:*",
    "@types/proper-lockfile": "^4.1.4"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/prompt-history-search",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Global Prompt History Search",
    "interface": "`Alt+R`, `/prompt-history`"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
