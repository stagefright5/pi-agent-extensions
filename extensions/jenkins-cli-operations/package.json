{
  "name": "@stagefright5/pi-jenkins-cli-operations",
  "version": "0.1.1",
  "description": "Guarded Jenkins operations for pi using the official Jenkins CLI",
  "type": "module",
  "keywords": [
    "jenkins",
    "ci"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "pi": {
    "skills": [
      "./SKILL.md"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/jenkins-cli-operations",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Jenkins CLI Operations",
    "interface": "`/skill:jenkins-cli-operations`"
  }
}
