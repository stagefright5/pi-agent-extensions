{
  "name": "@stagefright5/pi-bang-dont-ghost",
  "version": "0.0.3",
  "description": "Automatically continue pi after a user-entered single-bang shell command",
  "type": "module",
  "keywords": [
    "bash",
    "shell",
    "follow-up"
  ],
  "scripts": {
    "test": "node --test index.test.ts scripts/patch-pi-user-bash-result.test.mjs",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/bang-dont-ghost",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Bang Don't Ghost",
    "interface": "Automatic"
  }
}
