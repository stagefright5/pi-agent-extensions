{
  "name": "@stagefright5/pi-side-agent",
  "version": "0.1.0",
  "description": "Open an independent, fully capable side agent forked from the current conversation in a Rex split",
  "type": "module",
  "keywords": [
    "fork",
    "side-agent",
    "rex",
    "tui"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@stagefright5/pi-dialog": "workspace:*",
    "typebox": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/side-agent",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Side Agent",
    "interface": "`/side`, `/side new`, `/side send`, `/side inbox`, `side_agent_send`"
  }
}
