{
  "name": "@stagefright5/pi-plan-mode",
  "version": "0.1.2",
  "description": "Evidence-guided planning and interactive plan review for pi",
  "type": "module",
  "keywords": [
    "planning"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@stagefright5/pi-picker": "workspace:*",
    "typebox": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/plan-mode",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Plan Mode",
    "interface": "`/plan`, `Alt+P`"
  }
}
