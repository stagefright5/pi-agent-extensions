{
  "name": "@stagefright5/pi-bg-bash",
  "version": "0.0.0",
  "description": "Run pi's bash tool commands in the background once they outlast a short wait, with job tools, finish notifications, and a jobs manager",
  "type": "module",
  "keywords": [
    "bash",
    "background",
    "jobs",
    "tui"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@stagefright5/pi-extension-utils": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@stagefright5/pi-picker": "workspace:*",
    "typebox": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/bg-bash",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Background Bash",
    "interface": "`bash` override, `job_*` tools, `/jobs`, `Alt+J`"
  }
}
