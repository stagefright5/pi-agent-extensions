{
  "name": "@stagefright5/pi-obsidian-ui",
  "version": "0.2.0",
  "description": "A copy-friendly graphite and ice theme with compact tool presentation for pi",
  "type": "module",
  "keywords": [
    "theme",
    "tui"
  ],
  "scripts": {
    "test": "node --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/obsidian-ice.json"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/obsidian-ui",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Obsidian UI",
    "interface": "Automatic tool styling; `obsidian-ice` theme",
    "include": [
      "themes"
    ]
  }
}
