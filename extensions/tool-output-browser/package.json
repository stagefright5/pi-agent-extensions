{
  "name": "@stagefright5/pi-tool-output-browser",
  "version": "0.1.1",
  "description": "Browse complete stored tool results without expanding every pi transcript row",
  "type": "module",
  "keywords": [
    "tool-output",
    "tui"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/tool-output-browser",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Tool Output Browser",
    "interface": "`/tool-output`"
  }
}
