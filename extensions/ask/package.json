{
  "name": "@stagefright5/pi-ask",
  "version": "0.1.1",
  "description": "Ask before decisions by applying a one-turn interaction policy in pi",
  "type": "module",
  "keywords": [
    "ask",
    "prompt-policy"
  ],
  "scripts": {
    "test": "node --test ask-prompt.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/ask",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Ask",
    "interface": "`/ask <task>`"
  }
}
