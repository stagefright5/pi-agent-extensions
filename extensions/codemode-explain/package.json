{
  "name": "@stagefright5/pi-codemode-explain",
  "version": "0.0.0",
  "description": "Replace collapsed codemode script previews with a one-line summary written by a small model",
  "type": "module",
  "keywords": [
    "codemode",
    "tui"
  ],
  "scripts": {
    "test": "node --experimental-transform-types --test *.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/codemode-explain",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Codemode Explain",
    "interface": "Automatic"
  }
}
