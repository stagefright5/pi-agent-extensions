{
  "name": "@stagefright5/pi-openai-fast",
  "version": "0.1.0",
  "description": "Toggle OpenAI Fast mode (priority service tier) in pi",
  "type": "module",
  "keywords": [
    "openai",
    "fast-mode"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/openai-fast",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "OpenAI Fast",
    "interface": "`/fast`, `pi --fast`"
  }
}
