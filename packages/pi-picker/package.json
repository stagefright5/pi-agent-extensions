{
  "name": "@stagefright5/pi-picker",
  "version": "0.1.0",
  "description": "Fast multi-word fuzzy search, highlighted lists, and picker overlays for pi extensions",
  "type": "module",
  "keywords": [
    "search",
    "fuzzy",
    "picker",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test src/**/*.test.ts",
    "bench": "node bench/bench.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:"
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/pi-picker",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Pi Picker",
    "interface": "Library: `createPicker`, `Searcher`, `renderInlinePanel`",
    "include": [
      "src"
    ]
  }
}
