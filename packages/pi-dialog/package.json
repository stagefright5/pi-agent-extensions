{
  "name": "@stagefright5/pi-dialog",
  "version": "0.1.0",
  "description": "Framed pop-ups and ready-made dialogs (confirm, select, input, editor, document, loader) for pi extensions",
  "type": "module",
  "keywords": [
    "dialog",
    "popup",
    "overlay",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@stagefright5/pi-picker": "workspace:*"
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/pi-dialog",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Pi Dialog",
    "interface": "Library: `openPopup`, `Popup`, `confirm`, `select`, `input`, `showDocument`",
    "include": [
      "src"
    ]
  }
}
