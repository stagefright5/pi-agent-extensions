{
  "name": "@stagefright5/jenkins-cli",
  "version": "0.1.1",
  "description": "Guarded Jenkins CLI with named profiles, build validation, and artifact downloads",
  "type": "module",
  "bin": {
    "jenkins": "./scripts/jenkins.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "jenkins",
    "cli",
    "ci"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepack": "node ../../scripts/package-tools.mjs stage-package"
  },
  "publishConfig": {
    "directory": "../../.tmp/publish/jenkins-cli",
    "linkDirectory": false
  },
  "packageTools": {
    "title": "Jenkins CLI",
    "interface": "`jenkins`",
    "include": [
      "scripts"
    ]
  }
}
